{
  "name": "@leveracc/widget",
  "version": "0.1.0-alpha.9",
  "type": "module",
  "description": "Embeddable LeverAcc account and lending widget",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "docs"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./widget.js": "./dist/widget.js",
    "./wallets": {
      "types": "./dist/wallets.d.ts",
      "import": "./dist/wallets.js"
    },
    "./wallets/react": {
      "types": "./dist/wallets-react.d.ts",
      "import": "./dist/wallets-react.js"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build && vite build --config vite.embed.config.ts && tsc -p tsconfig.build.json",
    "build:examples": "pnpm typecheck:examples && vite build --config vite.examples.config.ts",
    "abi:sync": "node scripts/sync-abis.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts examples *.ts *.json",
    "check": "pnpm test && pnpm build && pnpm build:examples && pnpm test:browser",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "prepack": "pnpm build",
    "test:package": "node scripts/check-package.mjs",
    "release:check": "pnpm test:release && pnpm check && pnpm test:package",
    "pack:local": "node scripts/pack-local.mjs",
    "publish:local": "npm run pack:local",
    "example:npm:setup": "node scripts/setup-npm-example.mjs",
    "example:npm": "npm --prefix examples/npm run dev",
    "example:npm:build": "npm --prefix examples/npm run build",
    "example:npm:test": "playwright test --config playwright.npm.config.ts",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:npm:dry-run": "node scripts/publish-npm.mjs --dry-run",
    "test:release": "node --test scripts/publish-npm.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.1",
    "viem": "~2.56.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@privy-io/react-auth": "3.38.0",
    "@tanstack/react-query": "5.90.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wagmi": "3.1.0"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
