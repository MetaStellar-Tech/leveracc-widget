import { createRoot } from 'react-dom/client';
import { useState } from 'react';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from '../../../leveracc-dapp/components/ui/dialog';
import { AccountTransferForm } from '../../../leveracc-dapp/components/account/AccountTransferForm';
import { CreateTradeAccountModal } from '../../../leveracc-dapp/components/account/CreateTradeAccountModal';
import { QuickBorrowForm } from '../../../leveracc-dapp/components/trading/quick-borrow-form';
import { FundDepositForm } from '../../../leveracc-dapp/components/trading/fund-deposit-form';
import { WithdrawModalForm } from '../../../leveracc-dapp/components/withdraw/WithdrawModalForm';
import RepayDialogs from '../../../leveracc-dapp/app/[locale]/trader/components/RepayDialogs';
import { Info } from 'lucide-react';
import { TokenUSDC } from '@web3icons/react';
import { useTranslations } from './stubs.tsx.fixture';
const owner = '0x1111111111111111111111111111111111111111', account = '0x2222222222222222222222222222222222222222';
const noop = () => {};
function Reference() {
 const key = new URLSearchParams(location.search).get('modal') ?? 'transfer';
 const t=useTranslations(key === 'withdraw' ? 'arbitrumWithdraw' : key === 'deposit' ? 'fundDepositModal' : 'borrow.quickBorrow');
 const [amount,setAmount]=useState(''), [source,setSource]=useState('trade');
 if(key==='create') return <CreateTradeAccountModal owner={owner} onClose={noop} onCreate={async()=>true} creating={false} checking={false}/>;
 if(key==='repay') return <RepayDialogs repayModalOpen onRepayModalClose={noop} selectedLoan={{funding_request_id:'account',amount:'100',outstanding_principal:'100',interest_due:'0.25'} as any} accountLevelMode accountLevelRepayAmount={amount} onAccountLevelRepayAmountChange={setAmount} onRepayConfirm={noop} isRepaying={null}/>;
 return <Dialog open><DialogContent className={key==='borrow' ? 'max-h-[90dvh] overflow-y-auto border-border px-6 sm:max-w-md' : 'grid-cols-[minmax(0,1fr)] max-h-[calc(100dvh-32px)] overflow-y-auto border-border bg-card px-6 sm:max-w-[512px]'}>
 {key==='transfer' ? <AccountTransferForm owner={owner} account={account} direction="fund-to-trade" amount={amount} balance="1250" destinationBalance="425.5" receive="0.00" busy={false} complete={false} canSubmit={false} status={null} error={null} onAmount={setAmount} onMax={noop} onReverse={noop} onSubmit={noop}/> : <>
 {key==='withdraw' && <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#0099ff]/20"><TokenUSDC size={40} variant="background" className="size-10 rounded-full overflow-hidden"/></div>}
 <DialogHeader className={key==='withdraw'?'space-y-2 text-center sm:text-center':'text-left'}><DialogTitle className="text-xl font-bold text-white">{t('title')}</DialogTitle>{key!=='borrow' && <DialogDescription>{t(key==='deposit'?'bridgeDescription':'description')}</DialogDescription>}</DialogHeader>
 {key==='borrow' ? <QuickBorrowForm borrowAmount={amount} onBorrowAmountChange={setAmount} remainingBorrowable={1800} minBorrowAmount={1} onBorrow={noop} isBorrowing={false} hasTraderAccount isAuthenticated/> : key==='deposit' ? <div className="mt-2 min-w-0 space-y-5"><div className="flex items-start gap-2 rounded-lg border border-[#F65959]/25 bg-[#F65959]/10 p-3"><Info className="mt-0.5 h-4 w-4 shrink-0 text-[#F65959]"/><p className="text-xs leading-relaxed text-[#F65959]">{t('bridgeWarning')}</p></div><FundDepositForm owner={owner} onBusyChange={noop}/></div> : <WithdrawModalForm state={{owner,account,mainnet:true,source,setSource,amount,setAmount,maximum:1175495000n,tradeReady:true,valid:false,submit:noop,feeLimit:null} as any}/>}
 </>}
 </DialogContent></Dialog>;
}
createRoot(document.getElementById('root')!).render(<Reference/>);
